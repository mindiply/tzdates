{
  "name": "tzdates",
  "version": "0.0.11",
  "description": "Bare-bone timezone aware date time functions",
  "type": "module",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "node": "./dist/node/index.js",
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mindiply/tzdates.git"
  },
  "scripts": {
    "genData": "ts-node ./scripts/genZonesData.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit",
    "build": "rm -fr ./dist && npm run build:cjs && npm run build:esm && npm run build:node",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:cjs-watch": "tsc --watch --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:esm-watch": "tsc --watch --project tsconfig.esm.json",
    "build:node": "tsc --project tsconfig.node.json",
    "build:node-watch": "tsc --watch --project tsconfig.node.json",
    "prepublishOnly": "npm run test && npm run build",
    "testSpeed": "ts-node ./scripts/timezonesTiming.ts"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "timezones",
    "dates",
    "typescript",
    "javascript",
    "immutable"
  ],
  "files": [
    "dist"
  ],
  "author": "Paolo F. Bongiovanni <paolo.bongiovanni@mindiply.com>",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node16": "^16.1.8",
    "@types/node": "^25.0.9",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
